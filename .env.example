# ============================================================
# .env.example - WalletBRED v:2
# Copia este archivo a `.env.local` para desarrollo local.
# No pongas secretos reales en este archivo.
# ============================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="WalletBRED"

# Supabase publico
VITE_SUPABASE_URL=https://nshutjhqgnsclvbhuxty.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=nshutjhqgnsclvbhuxty

# Supabase servidor
SUPABASE_URL=https://nshutjhqgnsclvbhuxty.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
ADMIN_IDS=91147095
ADMIN_TELEGRAM_USER_ID=91147095
ADMIN_WEB_ACCESS_KEY=your-private-owner-code
TELEGRAM_MINI_APP_URL=https://wallet-glow-link-wallet.vercel.app
TELEGRAM_WEBHOOK_URL=https://wallet-glow-link-wallet.vercel.app/api/public/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string
TELEGRAM_API_KEY=your-telegram-connector-key

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_URL=https://wallet-glow-link-wallet.vercel.app/api/public/stripe/webhook
STRIPE_PRICE_VIP_BASIC=price_or_amount
STRIPE_PRICE_VIP_PRO=price_or_amount
STRIPE_PRICE_VIP_ELITE=price_or_amount
STRIPE_TREASURY_FINANCIAL_ACCOUNT_ID=fa_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_TREASURY_CONNECTED_ACCOUNT_ID=acct_1TaQwi2camyZi7do

# IA
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key
AI_CHAT_MODEL=llama-3.1-8b-instant

# OpenAI opcional
OPENAI_API_KEY=sk-proj_optional-openai-api-key
